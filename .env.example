# Copy this file to .env and fill in what you need.
# Leaving LLM_PROVIDER=none (or the API key blank) runs NEXA in fully
# local fallback mode - no external API calls, no cost, works offline.

APP_NAME=NEXA AI Chatbot

# LLM provider: openai | anthropic | none
LLM_PROVIDER=none

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

LLM_TIMEOUT_SECONDS=20

DB_PATH=data/nexa.db
UPLOAD_DIR=uploads

LOG_LEVEL=INFO
LOG_FILE=data/nexa.log

HOST=0.0.0.0
PORT=8000
